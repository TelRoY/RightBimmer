<section class="hero">
  <!-- Анимированные частицы -->
  <div class="hero-particles">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <!-- Неоновые ореолы -->
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>

  <div class="container">
    <!-- Виджет курсов валют -->
    <div class="rates-widget">
      <div class="rates-header">
        <span class="rates-title">💱 Курсы валют</span>
        <span class="rates-update">
          <span class="rates-update-time">{{lastUpdate}}</span>
        </span>
        <button class="rates-refresh" title="Обновить курсы">⟳</button>
      </div>
      <div class="rates-grid">
        {{#each rates}}
        <div class="rate-item">
          <span class="rate-flag">{{flag}}</span>
          <span class="rate-currency">{{currency}}</span>
          <span class="rate-value">{{rate}}</span>
        </div>
        {{/each}}
      </div>
      <div class="rates-note">* За 1 единицу валюты</div>
    </div>

    <!-- Основной контент -->
    <div class="hero-content">
      <div class="hero-badge">🚗 Привозим авто из Японии</div>
      <h1>
        Автомобили из Японии <br>
        <span class="highlight">с аукционов</span>
      </h1>
      <p>
        Поможем купить, доставить и растаможить автомобиль<br>
        из Японии под ключ
      </p>
      <div class="hero-buttons">
        <a href="#calculator" class="btn btn-primary">
          <span>Рассчитать стоимость</span>
        </a>
        <a href="#catalog" class="btn btn-secondary">Смотреть каталог</a>
      </div>
    </div>
  </div>
</section>