<section class='models section' id='catalog'>
  <div class='container'>
    <h2 class='section-title'>Популярные модели</h2>
    <div class='models-grid'>
      {{#each models}}
        <div class='model-item' data-car-id='{{id}}'>
          <div class='model-image'>
            <img src='{{image}}' alt='{{name}}' />
            {{#if badge}}
            <div class='model-badge'>{{badge}}</div>
            {{/if}}
          </div>
          <div class='model-info'>
            <h3>{{name}}</h3>
            <p class='model-year'>{{year}} год</p>
            <p class='model-price'>{{price}}</p>
            <a href='#' class='btn btn-small btn-primary'>Подробнее</a>
          </div>
        </div>
      {{/each}}
    </div>

    {{#if hasMore}}
    <div class='text-center'>
      <button class="btn btn-primary btn-large show-all-btn">
        Смотреть весь каталог
      </button>
    </div>
    {{/if}}
  </div>
</section>
