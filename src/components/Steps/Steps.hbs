<section class='steps-section section'>
  <div class='container'>
    <h2 class='section-title'>Как мы работаем</h2>
    <div class='steps-grid'>
      {{#each steps}}
        <div class='step-item'>
          <div class='step-number'>{{number}}</div>
          <h3>{{title}}</h3>
          <p>{{description}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>
